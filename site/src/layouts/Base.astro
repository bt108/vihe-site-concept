---
import { org } from '../config/org';
import '@fontsource/charis-sil/400.css';
import '@fontsource/charis-sil/400-italic.css';
import '@fontsource/charis-sil/700.css';
import '@fontsource/charis-sil/700-italic.css';

interface Props {
  BRAND_NAME?: string;
  HERO_TITLE?: string;
  HERO_SUB?: string;
}

const {
  BRAND_NAME = org.name,
  HERO_TITLE = org.hero.title,
  HERO_SUB = org.hero.sub,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{BRAND_NAME} — {HERO_TITLE}</title>
<meta name="description" content={HERO_SUB}>
<style is:global>
  /* Token vars mirror the Tailwind map (single source; no one-off hexes). */
  :root{
    /* VIHE palette — logo-artwork meanings, kept for future re-skins:
       primary #3F7D2B Meadow green (grass and leaves) · primary-dark #4A1C1C
       Deep maroon-brown (tree trunk; header, footer) · cta #E9B04B Saffron gold
       (figure's skin tone and glow) · accent #2B3F9E Peacock blue (peacock's neck;
       links, highlights) · sky #A9D2EA Sky blue (sky behind the tree; cards,
       banners) · clay #C48A4F Terracotta clay (hills on the right) · bg #FBF7EC
       Cream (dhoti and paper) · text #1A1A1A Near-black (ring and lettering) */
    --primary:#3F7D2B; --primary-dark:#4A1C1C; --cta:#E9B04B; --accent:#2B3F9E;
    --sky:#A9D2EA; --clay:#C48A4F; --bg:#FBF7EC; --surface:#FFFFFF; --text:#1A1A1A;
  }
  /* Offline fallback (same metrics; used only if the CDN is unreachable). */
  body{font-family:'Charis SIL',Georgia,'Times New Roman',serif;color:var(--text)}
  :where(h1,h2,h3,.font-head){font-family:'Charis SIL',Georgia,serif;color:var(--text)}
  .hero{min-height:656px}
  .hero-fade{background:linear-gradient(270deg,rgb(255 255 255 / 0) 45%,var(--bg) 97%)}
  .hero-wash{background:linear-gradient(270deg,transparent 33%,var(--bg) 50%)}
  .btn-solid{background:var(--primary);color:#fff;font-family:'Charis SIL',Georgia,serif;
    font-size:14px;font-weight:700;line-height:14px;border-radius:4px;padding:12px 32px;
    transition:background-color .25s ease,color .25s ease,border-color .25s ease,transform .25s ease,box-shadow .25s ease}
  .btn-solid:hover{background:var(--primary);filter:brightness(.92);transform:translateY(-1px);box-shadow:0 6px 16px rgb(0 0 0 / .18)}
  .btn-line{border:1px solid var(--primary);color:var(--primary);background:transparent;
    font-family:'Charis SIL',Georgia,serif;font-size:14px;font-weight:700;line-height:14px;
    border-radius:4px;padding:12px 32px;
    transition:background-color .25s ease,color .25s ease,border-color .25s ease,transform .25s ease,box-shadow .25s ease}
  .btn-line:hover{background:rgb(63 125 43 / .08);background:color-mix(in srgb,var(--primary) 9%,transparent);border-color:var(--primary);color:var(--primary);transform:translateY(-1px)}
  @media(max-width:767px){.hero{min-height:380px}.hero-wash{background:linear-gradient(305deg,transparent 100%,var(--bg) 100%)}}
  /* Mobile menu: eased open/close via grid-rows (animates both directions).
     visibility flips after the close motion so links are clickable only when open. */
  #mobileMenu{display:grid;grid-template-rows:0fr;opacity:0;transform:translateY(-8px);visibility:hidden;transition:grid-template-rows .3s ease,opacity .3s ease,transform .3s ease,visibility 0s linear .3s}
  #mobileMenu.open{grid-template-rows:1fr;opacity:1;transform:translateY(0);visibility:visible;transition:grid-template-rows .3s ease,opacity .3s ease,transform .3s ease,visibility 0s}
  #mobileMenu .mobileMenu-inner{overflow:hidden;min-height:0}
  #menuBtn{position:relative}
  #menuBtn .icon-close{position:absolute;inset:0;display:grid;place-items:center;opacity:0;transition:opacity .2s ease}
  #menuBtn .icon-open{transition:opacity .2s ease}
  #menuBtn.open .icon-open{opacity:0}
  #menuBtn.open .icon-close{opacity:1}
  @media (prefers-reduced-motion:reduce){#mobileMenu,#mobileMenu.open,#menuBtn .icon-open,#menuBtn .icon-close{transition:none;transform:none}}
</style>
</head>

<body class="bg-bg text-text font-body antialiased">
<slot />
<script>
  // Mobile menu: class-driven eased open/close (see #mobileMenu CSS).
  (function(){
    var btn = document.getElementById('menuBtn');
    var menu = document.getElementById('mobileMenu');
    if(!btn || !menu) return;
    function set(open){
      menu.classList.toggle('open', open);
      btn.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.setAttribute('aria-hidden', open ? 'false' : 'true');
    }
    btn.addEventListener('click', function(){
      set(!menu.classList.contains('open'));
    });
    menu.addEventListener('click', function(e){
      if(e.target.tagName === 'A'){ set(false); }
    });
  })();
</script>
</body>
</html>
