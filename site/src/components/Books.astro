---
interface Props {
  BOOKS_LABEL?: string;
  BOOKS_TITLE?: string;
  BOOKS_SUB?: string;
}

const {
  BOOKS_LABEL = 'Study With Us',
  BOOKS_TITLE = 'Study Materials & Publications',
  BOOKS_SUB = 'Course companions and publications prepared by VIHE faculty to support your study.',
} = Astro.props;
---
<section id="books" class="px-[15px] md:px-10 lg:px-[100px] py-[75px] lg:py-[100px] max-w-[1600px] mx-auto">
  <div class="text-center max-w-[720px] mx-auto mb-10">
    <span class="inline-block text-[12px] font-bold tracking-[0.14em] uppercase text-accent mb-2.5">{BOOKS_LABEL}</span>
    <h2 class="font-head font-semibold text-text text-[24px] leading-[26px] md:text-[32px] lg:text-[36px] lg:leading-[50px] mb-2.5">{BOOKS_TITLE}</h2>
    <p class="text-text">{BOOKS_SUB}</p>
  </div>
  <div class="grid lg:grid-cols-2 gap-7">
    <article class="grid grid-cols-[140px_1fr] sm:grid-cols-[200px_1fr] border border-clay rounded-card overflow-hidden bg-surface">
      <img src="/assets/placeholders/cover-3x4.svg" width="600" height="800" alt="Bhakti-sastri study material" class="w-full h-full object-cover bg-bg min-h-[260px]">
      <div class="p-6 flex flex-col gap-2.5">
        <h3 class="font-head text-xl text-text">Bhakti-sastri Study Material</h3>
        <div class="text-[12px] font-bold tracking-[0.08em] uppercase text-text">Print & Digital &nbsp;|&nbsp; By <b class="text-accent">VIHE faculty</b></div>
        <p class="text-[15px] flex-1">Companion notes, verse sheets and assessments for the Bhakti-sastri course.</p>
        <div class="flex items-center justify-between gap-3 border-t border-bg pt-3.5 mt-1">
          <span class="font-extrabold text-lg text-text">VIHE Campus</span>
          <a href="#contact" class="btn-line">View Details</a>
        </div>
      </div>
    </article>
    <article class="grid grid-cols-[140px_1fr] sm:grid-cols-[200px_1fr] border border-clay rounded-card overflow-hidden bg-surface">
      <img src="/assets/placeholders/cover-1x1.svg" width="700" height="700" alt="Bhakti-vaibhava study material" class="w-full h-full object-cover bg-bg min-h-[260px]">
      <div class="p-6 flex flex-col gap-2.5">
        <h3 class="font-head text-xl text-text">Bhakti-vaibhava Study Material</h3>
        <div class="text-[12px] font-bold tracking-[0.08em] uppercase text-text">Print & Digital &nbsp;|&nbsp; By <b class="text-accent">VIHE faculty</b></div>
        <p class="text-[15px] flex-1">Companion notes and reading guides for advanced Cantos study.</p>
        <div class="flex items-center justify-between gap-3 border-t border-bg pt-3.5 mt-1">
          <span class="font-extrabold text-lg text-text">VIHE Campus</span>
          <a href="#contact" class="btn-line">View Details</a>
        </div>
      </div>
    </article>
  </div>
</section>
