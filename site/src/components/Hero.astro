---
import { org, type OrgCta } from '../config/org';

interface Props {
  HERO_TITLE?: string;
  HERO_SUB?: string;
  HERO_CTAS?: [OrgCta, OrgCta];
  HERO_IMAGE?: string;
}

const {
  HERO_TITLE = org.hero.title,
  HERO_SUB = org.hero.sub,
  HERO_CTAS = org.hero.ctas,
  HERO_IMAGE = org.hero.image,
} = Astro.props;
---
<section class="hero relative bg-bg overflow-hidden">
  <!-- absolute wash layer, mirrors f863d09 overlay -->
  <div class="hero-wash absolute inset-0 pointer-events-none"></div>
  <div class="relative max-w-[1600px] mx-auto grid lg:grid-cols-[90fr_180fr] items-stretch px-[15px] md:px-10 lg:px-[100px]">
    <!-- left text col (~90%) -->
    <div class="flex flex-col justify-center py-10 lg:py-[60px] lg:pr-6 lg:my-[40px] z-10">
      <h1 class="font-head font-semibold text-text text-[28px] leading-[28px] md:text-[34px] md:leading-[40px] lg:text-[42px] lg:leading-[58px] mb-[18px]">{HERO_TITLE}</h1>
      <p class="text-text text-[15px] leading-[21px] md:text-base md:leading-[22px] max-w-[34rem] mb-7">{HERO_SUB}</p>
      <div class="flex gap-[15px]">
        <a href={HERO_CTAS[0].href} class="btn-solid basis-[48%] sm:basis-auto text-center">{HERO_CTAS[0].label}</a>
        <a href={HERO_CTAS[1].href} class="btn-line basis-[48%] sm:basis-auto text-center">{HERO_CTAS[1].label}</a>
      </div>
    </div>
    <!-- right image col (~180%, overlapping, cover + fade). Below lg: full-bleed, no fade -->
    <div class="relative min-h-[380px] -mx-[15px] md:-mx-10 lg:ml-0 lg:min-h-[656px] lg:-mr-[100px]">
      <img src={HERO_IMAGE} width="1200" height="800" alt="Temples on the Yamuna at Vrindavan at dawn"
           class="absolute inset-0 w-full h-full object-cover">
      <div class="hero-fade absolute inset-0 pointer-events-none hidden lg:block"></div>
    </div>
  </div>
</section>
