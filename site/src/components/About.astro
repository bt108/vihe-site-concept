---
interface Props {
  ABOUT_LABEL?: string;
  ABOUT_TITLE?: string;
  ABOUT_SUB?: string;
}

const {
  ABOUT_LABEL = 'About VIHE',
  ABOUT_TITLE = 'Study Scripture in the Land of Krsna',
  ABOUT_SUB = 'Since 1987, devotees from around the world have come to Vrindavan to hear, study and serve — here is how you can join them.',
} = Astro.props;
---
<section id="get-started" class="bg-mist px-[15px] md:px-10 lg:px-[100px] py-[75px] lg:py-[100px]">
  <div class="max-w-[1600px] mx-auto">
    <div class="text-center max-w-[720px] mx-auto mb-10">
      <span class="inline-block text-[12px] font-bold tracking-[0.14em] uppercase text-accent mb-2.5">{ABOUT_LABEL}</span>
      <h2 class="font-head font-semibold text-ink text-[24px] leading-[26px] md:text-[32px] lg:text-[36px] lg:leading-[50px] mb-2.5">{ABOUT_TITLE}</h2>
      <p class="text-body">{ABOUT_SUB}</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-11 items-center py-[34px] border-b border-sage">
      <div>
        <h3 class="font-head text-[26px] text-ink mb-3">Serving Since 1987</h3>
        <p class="mb-4">Founded in Sri Vrindavan Dhama, VIHE carries Srila Prabhupada’s vision of systematic Vaisnava education — combining sadhana, study and preaching.</p>
        <a href="#contact" class="btn-line inline-block">Learn More</a>
      </div>
      <img src="/assets/placeholders/about-16x9.svg" width="610" height="344" alt="VIHE campus in Vrindavan" class="w-full aspect-video object-cover rounded-card bg-cloud">
    </div>

    <div class="grid lg:grid-cols-2 gap-11 items-center py-[34px] border-b border-sage">
      <div class="lg:order-2">
        <h3 class="font-head text-[26px] text-ink mb-3">Study in the Dhama</h3>
        <p class="mb-4">Live and learn where the scriptures were lived — daily temple programs, parikramas and association with senior devotees.</p>
        <a href="#courses" class="btn-line inline-block">Learn More</a>
      </div>
      <div class="lg:order-1 relative w-full aspect-video rounded-card bg-ink grid place-items-center overflow-hidden cursor-pointer" role="button" tabindex="0" aria-label="Play video placeholder">
        <img src="/assets/placeholders/about-16x9.svg" width="610" height="344" alt="" class="absolute inset-0 w-full h-full object-cover opacity-50">
        <span class="relative w-[72px] h-[72px] rounded-full bg-white grid place-items-center text-xl text-ink">&#9654;</span>
        <span class="absolute bottom-3 inset-x-0 text-center text-white text-[12px] tracking-wide">Video · 16:9 placeholder</span>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-11 items-center py-[34px] border-b border-sage">
      <div>
        <h3 class="font-head text-[26px] text-ink mb-3">Systematic Courses</h3>
        <p class="mb-4">From Bhakti-sadacara and Bhakti-pravesa to Bhakti-sastri, Bhakti-vaibhava and Bhakti-vedanta — on-site in Vrindavan and online.</p>
        <a href="#courses" class="btn-line inline-block">Learn More</a>
      </div>
      <div class="relative w-full aspect-video rounded-card bg-ink grid place-items-center overflow-hidden cursor-pointer" role="button" tabindex="0" aria-label="Play video placeholder">
        <img src="/assets/placeholders/about-16x9.svg" width="610" height="344" alt="" class="absolute inset-0 w-full h-full object-cover opacity-50">
        <span class="relative w-[72px] h-[72px] rounded-full bg-white grid place-items-center text-xl text-ink">&#9654;</span>
        <span class="absolute bottom-3 inset-x-0 text-center text-white text-[12px] tracking-wide">Video · 16:9 placeholder</span>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-11 items-center py-[34px] border-b border-sage">
      <div class="lg:order-2">
        <h3 class="font-head text-[26px] text-ink mb-3">Sadhana & Community</h3>
        <p class="mb-4">Morning Bhagavatam, kirtan and service alongside devotees from every continent — study supported by a living community.</p>
        <a href="#retreats" class="btn-line inline-block">Learn More</a>
      </div>
      <div class="lg:order-1 relative w-full aspect-video rounded-card bg-ink grid place-items-center overflow-hidden cursor-pointer" role="button" tabindex="0" aria-label="Play video placeholder">
        <img src="/assets/placeholders/about-16x9.svg" width="610" height="344" alt="" class="absolute inset-0 w-full h-full object-cover opacity-50">
        <span class="relative w-[72px] h-[72px] rounded-full bg-white grid place-items-center text-xl text-ink">&#9654;</span>
        <span class="absolute bottom-3 inset-x-0 text-center text-white text-[12px] tracking-wide">Video · 16:9 placeholder</span>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-11 items-center py-[34px]">
      <div>
        <h3 class="font-head text-[26px] text-ink mb-3">How to Join</h3>
        <p class="mb-4">Write to courses@vihe.org or call us — admissions for Winter 2025–26 are open now, and Caturmasya 2026 follows in summer.</p>
        <a href="#courses" class="btn-solid inline-block">Get Started</a>
      </div>
      <div class="relative w-full aspect-video rounded-card bg-ink grid place-items-center overflow-hidden cursor-pointer" role="button" tabindex="0" aria-label="Play video placeholder">
        <img src="/assets/placeholders/about-16x9.svg" width="610" height="344" alt="" class="absolute inset-0 w-full h-full object-cover opacity-50">
        <span class="relative w-[72px] h-[72px] rounded-full bg-white grid place-items-center text-xl text-ink">&#9654;</span>
        <span class="absolute bottom-3 inset-x-0 text-center text-white text-[12px] tracking-wide">Video · 16:9 placeholder</span>
      </div>
    </div>
  </div>
</section>
