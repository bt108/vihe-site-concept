---
import { org } from '../config/org';

interface Props {
  RES_LABEL?: string;
  RES_TITLE?: string;
  RES_SUB?: string;
}

const {
  RES_LABEL = org.resourcesHeader.label,
  RES_TITLE = org.resourcesHeader.title,
  RES_SUB = org.resourcesHeader.sub,
} = Astro.props;
---
<section id="resources" class="px-[15px] md:px-10 lg:px-[100px] py-[75px] lg:py-[100px]">
  <div class="max-w-[1600px] mx-auto">
    <div class="text-center max-w-[720px] mx-auto mb-10">
      <span class="inline-block text-[12px] font-bold tracking-[0.14em] uppercase text-accent mb-2.5">{RES_LABEL}</span>
      <h2 class="font-head font-semibold text-text text-[24px] leading-[26px] md:text-[32px] lg:text-[36px] lg:leading-[50px] mb-2.5">{RES_TITLE}</h2>
      <p class="text-text">{RES_SUB}</p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-7">
      <article class="border border-clay rounded-card overflow-hidden bg-surface flex flex-col hover:shadow-lg transition">
        <img src="/assets/placeholders/card-16x9.svg" width="800" height="450" alt="Class audio recordings placeholder" class="w-full aspect-video object-cover bg-bg">
        <div class="p-[22px] flex flex-col gap-2.5 flex-1">
          <h3 class="font-head text-xl text-text">Class Audio Recordings</h3>
          <p class="text-[15px] flex-1">Listen to recordings of VIHE courses, morning classes and seminars — free for students and friends.</p>
          <div class="border-t border-bg pt-3.5 mt-1">
            <a href="#contact" class="btn-line inline-block">Listen</a>
          </div>
        </div>
      </article>
      <article class="border border-clay rounded-card overflow-hidden bg-surface flex flex-col hover:shadow-lg transition">
        <img src="/assets/placeholders/card-16x9.svg" width="800" height="450" alt="Library and study archive placeholder" class="w-full aspect-video object-cover bg-bg">
        <div class="p-[22px] flex flex-col gap-2.5 flex-1">
          <h3 class="font-head text-xl text-text">Library & Study Archive</h3>
          <p class="text-[15px] flex-1">Study materials, notes and reference texts kept for VIHE students, on-site and online.</p>
          <div class="border-t border-bg pt-3.5 mt-1">
            <a href="#contact" class="btn-line inline-block">Browse</a>
          </div>
        </div>
      </article>
      <article class="border border-clay rounded-card overflow-hidden bg-surface flex flex-col hover:shadow-lg transition">
        <img src="/assets/placeholders/card-16x9.svg" width="800" height="450" alt="Syllabi and reading lists placeholder" class="w-full aspect-video object-cover bg-bg">
        <div class="p-[22px] flex flex-col gap-2.5 flex-1">
          <h3 class="font-head text-xl text-text">Syllabi & Reading Lists</h3>
          <p class="text-[15px] flex-1">Course syllabi and book lists for Bhakti-sastri, Bhakti-vaibhava and other VIHE courses.</p>
          <div class="border-t border-bg pt-3.5 mt-1">
            <a href="#contact" class="btn-line inline-block">Browse</a>
          </div>
        </div>
      </article>
      <article class="border border-clay rounded-card overflow-hidden bg-surface flex flex-col hover:shadow-lg transition">
        <img src="/assets/placeholders/card-16x9.svg" width="800" height="450" alt="Helpful links placeholder" class="w-full aspect-video object-cover bg-bg">
        <div class="p-[22px] flex flex-col gap-2.5 flex-1">
          <h3 class="font-head text-xl text-text">Helpful Links</h3>
          <p class="text-[15px] flex-1">Admissions, seva, visits and contacts — write to us and we will point you to the right place.</p>
          <div class="border-t border-bg pt-3.5 mt-1">
            <a href="#contact" class="btn-line inline-block">Browse</a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
