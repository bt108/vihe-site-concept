---
interface Props {
  SOCIAL_TITLE?: string;
}

const {
  SOCIAL_TITLE = 'Follow VIHE',
} = Astro.props;
---
<div class="border-y border-mist bg-surface">
  <div class="max-w-[1600px] mx-auto px-[15px] md:px-10 lg:px-[100px] py-[22px] flex items-center justify-between gap-4 flex-wrap">
    <strong class="font-head text-ink">{SOCIAL_TITLE}</strong>
    <div class="flex gap-2.5" aria-label="Social links">
      <span class="w-10 h-10 rounded-full bg-cloud border border-sage grid place-items-center font-extrabold text-[13px] text-ink">f</span>
      <span class="w-10 h-10 rounded-full bg-cloud border border-sage grid place-items-center font-extrabold text-[13px] text-ink">x</span>
      <span class="w-10 h-10 rounded-full bg-cloud border border-sage grid place-items-center font-extrabold text-[13px] text-ink">in</span>
      <span class="w-10 h-10 rounded-full bg-cloud border border-sage grid place-items-center font-extrabold text-[13px] text-ink">yt</span>
      <span class="w-10 h-10 rounded-full bg-cloud border border-sage grid place-items-center font-extrabold text-[13px] text-ink">ig</span>
    </div>
  </div>
</div>
