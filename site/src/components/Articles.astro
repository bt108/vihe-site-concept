---
interface Props {
  ARTICLES_LABEL?: string;
  ARTICLES_TITLE?: string;
  ARTICLES_SUB?: string;
}

const {
  ARTICLES_LABEL = 'Writings',
  ARTICLES_TITLE = 'Reflections & Writings',
  ARTICLES_SUB = 'Essays and reflections from VIHE teachers and students on sadhana, scripture and life in the Dhama.',
} = Astro.props;
---
<section id="articles" class="px-[15px] md:px-10 lg:px-[100px] py-[75px] lg:py-[100px] max-w-[1600px] mx-auto">
  <div class="text-center max-w-[720px] mx-auto mb-10">
    <span class="inline-block text-[12px] font-bold tracking-[0.14em] uppercase text-accent mb-2.5">{ARTICLES_LABEL}</span>
    <h2 class="font-head font-semibold text-text text-[24px] leading-[26px] md:text-[32px] lg:text-[36px] lg:leading-[50px] mb-2.5">{ARTICLES_TITLE}</h2>
    <p class="text-text">{ARTICLES_SUB}</p>
  </div>
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-7">
    <article class="border border-clay rounded-card overflow-hidden bg-surface flex flex-col hover:shadow-lg transition">
      <img src="/assets/placeholders/card-3x2.svg" width="800" height="534" alt="Why study in Vrindavan — VIHE article" class="w-full aspect-[3/2] object-cover bg-bg">
      <div class="p-[22px] flex flex-col gap-2.5 flex-1">
        <h3 class="font-head text-xl text-text">Why Study in Vrindavan?</h3>
        <p class="text-[15px] flex-1">On learning the scriptures in the Dhama where Krsna performed His pastimes.</p>
        <a href="#" class="font-bold text-accent text-[15px] hover:text-primary-dark">Read More &rarr;</a>
      </div>
    </article>
    <article class="border border-clay rounded-card overflow-hidden bg-surface flex flex-col hover:shadow-lg transition">
      <img src="/assets/placeholders/card-3x2.svg" width="800" height="534" alt="The purpose of Bhakti-sastri — VIHE article" class="w-full aspect-[3/2] object-cover bg-bg">
      <div class="p-[22px] flex flex-col gap-2.5 flex-1">
        <h3 class="font-head text-xl text-text">The Purpose of Bhakti-sastri</h3>
        <p class="text-[15px] flex-1">How systematic study deepens sadhana and equips devotees to share Krsna consciousness.</p>
        <a href="#" class="font-bold text-accent text-[15px] hover:text-primary-dark">Read More &rarr;</a>
      </div>
    </article>
    <article class="border border-clay rounded-card overflow-hidden bg-surface flex flex-col hover:shadow-lg transition">
      <img src="/assets/placeholders/card-3x2.svg" width="800" height="534" alt="Sadhana at VIHE — VIHE article" class="w-full aspect-[3/2] object-cover bg-bg">
      <div class="p-[22px] flex flex-col gap-2.5 flex-1">
        <h3 class="font-head text-xl text-text">Sadhana: the Heart of VIHE</h3>
        <p class="text-[15px] flex-1">Morning programs, kirtan and temple life — the daily rhythm behind every VIHE course.</p>
        <a href="#" class="font-bold text-accent text-[15px] hover:text-primary-dark">Read More &rarr;</a>
      </div>
    </article>
  </div>
  <div class="text-center mt-9"><a href="#" class="btn-line inline-block">Explore All</a></div>
</section>
